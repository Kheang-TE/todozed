{
    "buildCommand": "sed -i \"s|__API_URL__|${API_URL}|g\" assets/js/config.js",
    "outputDirectory": ".",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
